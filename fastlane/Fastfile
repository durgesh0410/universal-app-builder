default_platform(:android)
platform :android do
  desc "Upload AAB + Screenshots + Description to Play"
  lane :deploy do
    upload_to_play_store(
      track: 'internal',
      aab: 'arrowpuzzle/build/app/outputs/bundle/release/app-release.aab',
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end
end
